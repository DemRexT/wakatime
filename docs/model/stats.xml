<Package xmlns:xsi="" xmlns:xsd="">
    <Name>stats</Name>
    <Entities>
        <Entity Name="Stat" Namespace="stats" Table="stats">
            <Attributes>
                <Attribute Name="ID" DBName="id" DBType="int8" GoType="int64" PK="true" Nullable="Yes" Addable="true" Updatable="false" Min="0" Max="0"></Attribute>
                <Attribute Name="UserID" DBName="user_id" DBType="int4" GoType="int" PK="false" FK="User" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="Period" DBName="period" DBType="text" GoType="string" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="PeriodStart" DBName="period_start" DBType="date" GoType="time.Time" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="PeriodEnd" DBName="period_end" DBType="date" GoType="time.Time" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="TotalSeconds" DBName="total_seconds" DBType="int8" GoType="int64" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="DailyAverageSeconds" DBName="daily_average_seconds" DBType="int4" GoType="int" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="FetchedAt" DBName="fetched_at" DBType="timestamptz" GoType="time.Time" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
            </Attributes>
            <Searches>
                <Search Name="IDs" AttrName="ID" SearchType="SEARCHTYPE_ARRAY"></Search>
                <Search Name="PeriodILike" AttrName="Period" SearchType="SEARCHTYPE_ILIKE"></Search>
            </Searches>
        </Entity>
    </Entities>
</Package>
