<Package xmlns:xsi="" xmlns:xsd="">
    <Name>users</Name>
    <Entities>
        <Entity Name="User" Namespace="users" Table="users">
            <Attributes>
                <Attribute Name="ID" DBName="id" DBType="int4" GoType="int" PK="true" Nullable="Yes" Addable="true" Updatable="false" Min="0" Max="0"></Attribute>
                <Attribute Name="Username" DBName="username" DBType="text" GoType="string" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="WakatimeLogin" DBName="wakatime_login" DBType="text" GoType="string" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="WakatimeToken" DBName="wakatime_token" DBType="bytea" GoType="[]byte" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="StatusID" DBName="status_id" DBType="int4" GoType="int" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="CreatedAt" DBName="created_at" DBType="timestamptz" GoType="time.Time" PK="false" Nullable="No" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="LastSyncedAt" DBName="last_synced_at" DBType="timestamptz" GoType="*time.Time" PK="false" Nullable="Yes" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
                <Attribute Name="LastSyncError" DBName="last_sync_error" DBType="text" GoType="*string" PK="false" Nullable="Yes" Addable="true" Updatable="true" Min="0" Max="0"></Attribute>
            </Attributes>
            <Searches>
                <Search Name="IDs" AttrName="ID" SearchType="SEARCHTYPE_ARRAY"></Search>
                <Search Name="UsernameILike" AttrName="Username" SearchType="SEARCHTYPE_ILIKE"></Search>
                <Search Name="WakatimeLoginILike" AttrName="WakatimeLogin" SearchType="SEARCHTYPE_ILIKE"></Search>
                <Search Name="LastSyncErrorILike" AttrName="LastSyncError" SearchType="SEARCHTYPE_ILIKE"></Search>
            </Searches>
        </Entity>
    </Entities>
</Package>
