<?xml version="1.0" encoding="UTF-8"?>
<pgd version="1" pg-version="18" default-schema="public">
  <project name="wakatime">
    <settings>
      <naming convention="snake_case" tables="plural"></naming>
      <defaults nullable="false" on-delete="restrict" on-update="restrict"></defaults>
    </settings>
  </project>
  <roles></roles>
  <tablespaces></tablespaces>
  <extensions></extensions>
  <sequences></sequences>
  <schema name="public">
    <table name="users">
      <column name="id" type="integer" nullable="false">
        <identity generated="by-default"></identity>
      </column>
      <column name="username" type="text" nullable="false"></column>
      <column name="wakatime_login" type="text" nullable="false"></column>
      <column name="wakatime_token" type="bytea" nullable="false"></column>
      <column name="status_id" type="integer" nullable="false"></column>
      <column name="created_at" type="timestamptz" nullable="false" default="now()"></column>
      <column name="last_synced_at" type="timestamptz"></column>
      <column name="last_sync_error" type="text"></column>
      <pk name="pk_users">
        <column name="id"></column>
      </pk>
    </table>
    <table name="stats">
      <column name="id" type="bigint" nullable="false">
        <identity generated="by-default"></identity>
      </column>
      <column name="user_id" type="int" nullable="false"></column>
      <column name="period" type="text" nullable="false"></column>
      <column name="period_start" type="date" nullable="false"></column>
      <column name="period_end" type="date" nullable="false"></column>
      <column name="total_seconds" type="bigint" nullable="false"></column>
      <column name="daily_average_seconds" type="integer" nullable="false"></column>
      <column name="fetched_at" type="timestamptz" nullable="false"></column>
      <pk name="pk_stats">
        <column name="id"></column>
      </pk>
      <fk name="fk_stat_1" to-table="users" on-delete="restrict" on-update="restrict">
        <column name="user_id" references="id"></column>
      </fk>
    </table>
    <index name="uq_users_wakatime_login" table="users" unique="true" using="btree">
      <column name="wakatime_login"></column>
    </index>
    <index name="ix_users_status_id" table="users" using="btree">
      <column name="status_id"></column>
    </index>
    <index name="uq_stats_user_id" table="stats" unique="true" using="btree">
      <column name="user_id"></column>
    </index>
    <index name="uq_stats_period" table="stats" unique="true" using="btree">
      <column name="period"></column>
    </index>
    <index name="uq_stats_period_end" table="stats" unique="true" using="btree">
      <column name="period_end"></column>
    </index>
    <index name="ix_stats_user_id" table="stats" using="btree">
      <column name="user_id"></column>
    </index>
    <index name="ix_stats_fetched_at" table="stats" using="btree">
      <column name="fetched_at" order="desc"></column>
    </index>
  </schema>
  <functions></functions>
  <triggers></triggers>
  <rules></rules>
  <policies></policies>
  <comments></comments>
  <layouts>
    <layout name="Default" default="true">
      <entity schema="public" table="users" x="-460" y="-220"></entity>
      <entity schema="public" table="stats" x="-60" y="-120"></entity>
    </layout>
  </layouts>
</pgd>
